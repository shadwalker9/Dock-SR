+++ b/src/docksr_integration.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+// DockSR-owned, experiment-only adapter. Rendering state is owned exclusively
+// by the compositor thread. Console/script callbacks may only enqueue bounded
+// control messages; there is no external socket or per-frame IPC here.
+#include <string_view>
+
+struct FrameInfo_t;
+
+bool DockSRLabQueueCommand( std::string_view command );
+void DockSRLabApplyPending();
+void DockSRLabBeginFrame( FrameInfo_t *frame );
+void DockSRLabDispatched( FrameInfo_t *frame );
+void DockSRLabPresented( FrameInfo_t *frame );
+void DockSRLabFallback( FrameInfo_t *frame, const char *reason );
diff --git a/src/shaders/cs_docksr.comp b/src/shaders/cs_docksr.comp
new file mode 100644
index 0000000..1161472
--- /dev/null
+++ b/src/shaders/cs_docksr.comp
@@ -0,0 +1,19 @@
+// DockSR DSR010 owned experiment. Proof sentinel only; no quality claim.
+#version 460
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+#include "descriptor_set.h"
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+layout(binding = 0, scalar) uniform extent_t { uint width; uint height; };
+void main()
+{
+    uvec2 p = gl_GlobalInvocationID.xy;
+    if (p.x >= width || p.y >= height) return;
+    // Exact 3x nearest reconstruction preserves the complete source alpha.
+    vec4 color = texelFetch(s_samplers[0], ivec2(p / 3u), 0);
+    // Opt-in experimental visible proof, distinct from ordinary LINEAR.
+    // Keep alpha and premultiplied bounds even in the marked 48x48 corner.
+    if (p.x < 48u && p.y < 48u)
+        color.rgb = ((p.x / 8u + p.y / 8u) % 2u == 0u ? vec3(1,0,1) : vec3(0,1,1)) * color.a;
+    imageStore(dst, ivec2(p), color);
+}

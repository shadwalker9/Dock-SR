diff --git a/src/docksr_integration.cpp b/src/docksr_integration.cpp
new file mode 100644
index 0000000..3f97af6
--- /dev/null
+++ b/src/docksr_integration.cpp
@@ -0,0 +1,274 @@
+// DockSR-owned R006-M1 adapter for the explicitly enabled experimental build.
+// Neither a second frame scheduler nor evidence of physical display scanout.
+#include "docksr_integration.hpp"
+#include "docksr_lab.hpp"
+#include "main.hpp"
+#include "rendervulkan.hpp"
+#include "steamcompmgr.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <string>
+#include <unistd.h>
+
+namespace
+{
+constexpr std::size_t kQueueLimit = 16;
+constexpr std::size_t kCommandLimit = 256;
+
+bool Enabled()
+{
+    static const bool enabled = [] {
+        const char *value = std::getenv( "DOCKSR_LAB" );
+        return value && std::string_view( value ) == "1";
+    }();
+    return enabled;
+}
+
+docksr::lab::Identity Identity()
+{
+    docksr::lab::Identity identity;
+    identity.upstream_commit = "4d5b7f3c9e1b6d3ee41c5c460b835fe5e0fe71b3";
+    identity.docksr_commit = "d7cc16e67f2138030c9cf0cbd29e57e9d4967bac";
+    const auto tick = std::chrono::steady_clock::now().time_since_epoch().count();
+    identity.session_id = "docksr-" + std::to_string( getpid() ) + "-" + std::to_string( tick );
+    identity.environment = "explicit_context_not_supplied";
+    identity.capture_method = "none";
+    identity.evidence = docksr::lab::Evidence::NotRun;
+    if ( const char *value = std::getenv( "DOCKSR_LAB_EVIDENCE" ) )
+    {
+        // These opt-in labels identify the authorized test context. They do
+        // not detect hardware, prove pixels or turn a headless submit into a
+        // backend presentation. The calling hooks must establish operations.
+        const std::string_view context( value );
+        if ( context == "SOFTWARE_VULKAN" )
+        {
+            identity.evidence = docksr::lab::Evidence::SoftwareVulkan;
+            identity.environment = "explicit_software_vulkan_context";
+            identity.capture_method = "backend_submit_log";
+        }
+        else if ( context == "VIRTUAL_WINDOW" )
+        {
+            identity.evidence = docksr::lab::Evidence::VirtualWindow;
+            identity.environment = "explicit_virtual_window_context";
+            identity.capture_method = "backend_present_log";
+        }
+    }
+    return identity;
+}
+
+struct Adapter
+{
+    std::mutex queue_mutex;
+    std::deque<std::string> commands;
+    docksr::lab::LabState state{ Identity() };
+    std::uint64_t frame_sequence{};
+    bool bootstrapped{};
+};
+
+Adapter &GetAdapter()
+{
+    static Adapter adapter;
+    return adapter;
+}
+
+void Emit( const docksr::lab::LabState &state )
+{
+    // Only the compositor owner emits complete snapshots. Flush is deliberate
+    // for this diagnostic experiment; this is not a production logging policy.
+    const std::string json = state.json();
+    std::fputs( "DOCKSR_STATUS ", stdout );
+    std::fwrite( json.data(), 1, json.size(), stdout );
+    std::fputc( '\n', stdout );
+    std::fflush( stdout );
+}
+
+bool HasExecutionContext( const Adapter &adapter )
+{
+    return adapter.state.valid() && docksr::lab::execution_evidence( adapter.state.identity().evidence );
+}
+
+docksr::lab::FrameToken Token( const FrameInfo_t *frame )
+{
+    return { frame->docksrFrameId, frame->docksrGeneration };
+}
+
+void UseLinear( FrameInfo_t *frame )
+{
+    // Selection flags are consumed separately from eUpscaleFilter by the
+    // Vulkan composition path. Clear every reconstruction prepass flag so a
+    // fallback cannot accidentally dispatch another selected algorithm.
+    frame->useFSRLayer0 = frame->useNISLayer0 = frame->useSGSRLayer0 = false;
+    frame->useDockSRLayer0 = false;
+    frame->eUpscaleFilter = GamescopeUpscaleFilter::LINEAR;
+    if ( frame->layers.count() )
+        frame->layers.get( 0 ).filter = GamescopeUpscaleFilter::LINEAR;
+}
+
+void RejectQueue( const char *reason )
+{
+    // No LabState mutation from a console/script thread. No success ack is
+    // emitted for commands that never reached the compositor-owned parser.
+    std::fprintf( stderr, "DOCKSR_CONTROL_REJECTED %s\n", reason );
+}
+}
+
+bool DockSRLabQueueCommand( std::string_view command )
+{
+    if ( !Enabled() )
+        return false;
+    if ( command.empty() || command.size() > kCommandLimit )
+    {
+        RejectQueue( "CONTROL_QUEUE_BOUNDS" );
+        return false;
+    }
+    for ( std::size_t index = 0; index < command.size(); ++index )
+    {
+        const unsigned char value = command[index];
+        if ( ( value < 0x20 || value > 0x7e ) && !( value == '\n' && index + 1 == command.size() ) )
+        {
+            RejectQueue( "CONTROL_QUEUE_ENCODING" );
+            return false;
+        }
+    }
+    auto &adapter = GetAdapter();
+    std::lock_guard lock( adapter.queue_mutex );
+    if ( adapter.commands.size() >= kQueueLimit )
+    {
+        RejectQueue( "CONTROL_QUEUE_FULL" );
+        return false;
+    }
+    adapter.commands.emplace_back( command );
+    return true;
+}
+
+void DockSRLabApplyPending()
+{
+    if ( !Enabled() )
+        return;
+    auto &adapter = GetAdapter();
+    if ( !adapter.bootstrapped )
+    {
+        adapter.bootstrapped = true;
+        // Reserve request 1 for an explicitly selected initial -F docksr.
+        // Ordinary CLI filters remain unchanged until an accepted ON/BYPASS.
+        if ( g_wantedUpscaleFilter == GamescopeUpscaleFilter::DOCKSR )
+        {
+            adapter.state.command( "ON 1" );
+            Emit( adapter.state );
+        }
+    }
+    std::deque<std::string> pending;
+    {
+        std::lock_guard lock( adapter.queue_mutex );
+        pending.swap( adapter.commands );
+    }
+    for ( const auto &command : pending )
+    {
+        const auto reply = adapter.state.command( command );
+        if ( reply.accepted && reply.ack == "PENDING" )
+            g_wantedUpscaleFilter = adapter.state.snapshot().mode_requested == docksr::lab::Mode::Active
+                ? GamescopeUpscaleFilter::DOCKSR : GamescopeUpscaleFilter::LINEAR;
+        Emit( adapter.state );
+    }
+}
+
+void DockSRLabBeginFrame( FrameInfo_t *frame )
+{
+    if ( !Enabled() || !frame )
+        return;
+    frame->docksrFrameId = frame->docksrGeneration = 0;
+    frame->docksrDispatched = false;
+    auto &adapter = GetAdapter();
+    if ( !HasExecutionContext( adapter ) )
+        return;
+    if ( adapter.frame_sequence == std::numeric_limits<std::uint64_t>::max() )
+    {
+        RejectQueue( "FRAME_SEQUENCE_EXHAUSTED" );
+        return;
+    }
+    const bool resources = frame->layers.count() > 0 && frame->layers.get( 0 ).tex;
+    docksr::lab::Extent input{};
+    bool sdr = frame->outputEncodingEOTF == EOTF_Gamma22;
+    if ( resources )
+    {
+        const auto &layer = frame->layers.get( 0 );
+        input = { layer.tex->width(), layer.tex->height() };
+        sdr = sdr && !layer.isYcbcr() &&
+            ( layer.colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR ||
+              layer.colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB );
+    }
+    // Entering this real frame/composition path establishes attachment, not a
+    // presentation. Empty frames cannot establish a usable attached backend.
+    adapter.state.set_attached( resources );
+    const auto token = adapter.state.begin_frame( ++adapter.frame_sequence, input,
+        { currentOutputWidth, currentOutputHeight }, sdr, resources );
+    frame->docksrFrameId = token.id;
+    frame->docksrGeneration = token.generation;
+    if ( !token.id )
+        return;
+    if ( adapter.state.snapshot().mode_effective == docksr::lab::Mode::Fallback ||
+         adapter.state.snapshot().mode_effective == docksr::lab::Mode::Unavailable )
+        UseLinear( frame );
+    else if ( adapter.state.snapshot().mode_requested == docksr::lab::Mode::Active &&
+              frame->eUpscaleFilter != GamescopeUpscaleFilter::DOCKSR )
+        DockSRLabFallback( frame, "FILTER_NOT_SELECTED" );
+    else if ( adapter.state.snapshot().mode_requested == docksr::lab::Mode::Active &&
+              !frame->useDockSRLayer0 )
+        DockSRLabFallback( frame, "FILTER_NOT_DISPATCHABLE" );
+    else if ( adapter.state.snapshot().mode_requested != docksr::lab::Mode::Active &&
+              ( frame->eUpscaleFilter == GamescopeUpscaleFilter::DOCKSR || frame->useDockSRLayer0 ) )
+        DockSRLabFallback( frame, "FILTER_CONTROL_MISMATCH" );
+}
+
+void DockSRLabDispatched( FrameInfo_t *frame )
+{
+    if ( !Enabled() || !frame || !frame->docksrFrameId )
+        return;
+    auto &adapter = GetAdapter();
+    if ( adapter.state.mark_dispatched( Token( frame ) ) )
+        frame->docksrDispatched = true;
+}
+
+void DockSRLabPresented( FrameInfo_t *frame )
+{
+    if ( !Enabled() || !frame || !frame->docksrFrameId )
+        return;
+    auto &adapter = GetAdapter();
+    // Callers must have completed a genuine connector/backend presentation.
+    // A compute submit, headless frame or returned texture is insufficient.
+    adapter.state.mark_presented( Token( frame ) );
+    Emit( adapter.state );
+}
+
+void DockSRLabFallback( FrameInfo_t *frame, const char *reason )
+{
+    if ( !Enabled() || !frame || !frame->docksrFrameId )
+        return;
+    auto &adapter = GetAdapter();
+    std::string code;
+    if ( reason )
+    {
+        for ( std::size_t index = 0; index <= 128 && reason[index]; ++index )
+        {
+            const char value = reason[index];
+            if ( !( ( value >= 'a' && value <= 'z' ) || ( value >= 'A' && value <= 'Z' ) ||
+                    ( value >= '0' && value <= '9' ) || value == '_' || value == '-' || value == '.' || value == ':' ) )
+            {
+                code.clear();
+                break;
+            }
+            code += value;
+        }
+    }
+    if ( code.empty() || code.size() > 128 )
+        code = "ADAPTER_FALLBACK";
+    adapter.state.fail_frame( Token( frame ), code );
+    frame->docksrDispatched = false;
+    UseLinear( frame );
+    Emit( adapter.state );
+}

            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          }
        },
        "backend_kind": {
          "enum": [
            "CPU_REFERENCE",
            "DETERMINISTIC_MOCK",
            "UNAVAILABLE"
          ]
        },
        "evidence_class": {
          "enum": [
            "REAL_CPU",
            "SIMULATED",
            "NOT_RUN"
          ]
        },

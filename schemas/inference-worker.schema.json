          "$ref": "#/$defs/extent"
        },
        "expected_output_format": {
          "enum": [
            "RGB8",
            "RGBA8",
            "RGB_INT8",
            "RGBA_INT8",
            "RGB_FLOAT32",
            "RGBA_FLOAT32"
          ]
        },
        "expected_output_shape": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": 1
            }
          ],
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          }
        },
        "expected_output_dtype": {
          "enum": [
            "int8",
            "uint8",
            "float32"
          ]
        },
        "expected_output_layout": {
          "enum": [
            "NCHW",
            "NHWC"
          ]
        },
        "tile": {
          "anyOf": [
            {
              "$ref": "#/$defs/tile"
            },
            {
              "type": "null"
            }
          ]
        }
      }

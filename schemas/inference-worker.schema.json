              ],
              "properties": {
                "name": {
                  "const": "VitisAiNpuBackend"
                },
                "status": {
                  "const": "NOT_IMPLEMENTED"
                },
                "evidence": {
                  "const": "NOT_RUN"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status",
                "evidence"
              ],
              "properties": {
                "name": {
                  "const": "FutureXrtBackend"
                },
                "status": {
                  "const": "NOT_IMPLEMENTED"
                },
                "evidence": {
                  "const": "NOT_RUN"
                }
              }
            }
          ],
          "items": false
        },
        "npu_inference_verified": {
          "const": false

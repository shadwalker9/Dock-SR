        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_extent": {
          "$ref": "#/$defs/extent"
        },
        "source_format": {
          "enum": [
            "RGB8",
            "RGBA8",
            "RGB_INT8",
            "RGBA_INT8",
            "RGB_FLOAT32",
            "RGBA_FLOAT32"
          ]
        },
        "tensor_shape": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": 1
            }
          ],
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          }
        },
        "tensor_dtype": {
          "enum": [
            "int8",
            "uint8",
            "float32"
          ]
        },
        "tensor_layout": {
          "enum": [
            "NCHW",
            "NHWC"
          ]
        },
        "buffer_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "buffer_stride": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          }
        },
        "buffer_ownership": {
          "const": "TRANSFERRED_HOST"
        },
        "submit_timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },

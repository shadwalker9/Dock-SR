          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"

    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_type",
        "session_id",
        "frame_id",
        "configuration_generation",
        "model_id",
        "model_sha256",
        "trace_id",
        "output_extent",
        "output_format",

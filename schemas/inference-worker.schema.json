          "type": "boolean"
        },
        "completion_timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "copy_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "logical_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "inference_duration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_unit": {
          "const": "nanoseconds"
        },
        "output_buffer_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ledger": {
          "$ref": "#/$defs/ledger"
        },
        "presented": {
          "const": false
        },
        "npu_device_detected": {
          "const": false
        },
        "npu_runtime_ready": {
          "const": false
        },
        "npu_inference_verified": {
          "const": false
        },
        "npu_game_frames_consumed": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend_kind": {
                "const": "UNAVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "valid": {
                "const": false
              },
              "evidence_class": {
                "const": "NOT_RUN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend_kind": {
                "const": "DETERMINISTIC_MOCK"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_class": {
                "const": "SIMULATED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend_kind": {
                "const": "CPU_REFERENCE"
              },
              "valid": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "evidence_class": {
                "const": "REAL_CPU"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend_kind": {
                "const": "CPU_REFERENCE"
              },
              "valid": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "evidence_class": {
                "enum": [
                  "REAL_CPU",
                  "NOT_RUN"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "output_buffer_size": {
                "minimum": 1
              },
              "fallback_reason": {
                "type": "null"
              },
              "inference_duration": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "ledger": {
                "properties": {
                  "deadline_missed": {
                    "const": false
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "fallback_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              },
              "backend_kind": {
                "const": "DETERMINISTIC_MOCK"
              }
            }
          },
          "then": {
            "properties": {
              "ledger": {
                "properties": {
                  "timing_class": {
                    "const": "SIMULATED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              },
              "backend_kind": {
                "const": "CPU_REFERENCE"
              }
            }
          },
          "then": {
            "properties": {
              "ledger": {
                "properties": {
                  "timing_class": {
                    "const": "OBSERVED_HOST_CPU"
                  }
                }
              }
            }
          }
        }
      ]

            {
              "type": "null"
            }
          ]
        },
        "deadline_missed": {
          "type": "boolean"
        },
        "duration_unit": {
          "const": "nanoseconds"
        },
        "timing_class": {
          "enum": [
            "NOT_RUN",
            "SIMULATED",
            "OBSERVED_HOST_CPU"
          ]
        },
        "runtime_internal_allocation_status": {
          "const": "UNKNOWN"
        },
        "runtime_internal_copy_status": {
          "const": "UNKNOWN"
        },
